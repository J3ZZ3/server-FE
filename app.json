{
  "expo": {
    "name": "Omakase",
    "slug": "clienta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "splash": {
        "splashScreenStayOpen": 4000
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show restaurant locations."
      }
    },
    "android": {
      "package": "com.koji.Omakase",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "splash": {
        "splashScreenStayOpen": 4000
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f1b94685-a358-4c5b-948b-98940572f268"
      }
    },
    "scheme": "myapp"
  }
}
